        <mxCell id="BxDQe3LZmpmF3q-F94Xu-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5282FF;perimeterSpacing=0;glass=0;verticalAlign=bottom;" value="Managed Kubernetes:&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;растянутый кластер, control plane (master) в 3х зонах (ru-central1-a/b/d);&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;namespaces: insure-tech для всех приложений;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;node groups: 2 узла в каждой зоне (2 vCPU / 8 GB);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;маршрутизация: Ingress (L7) -&amp;gt; Service (L4), readiness probe = health check;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;группа безопасности: приложение&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
